# ==============================================================================
# FILDLAB PERÚ S.A.C. - VARIABLES DE ENTORNO DEL SISTEMA (SI_FILDLAB-2026)
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL (Supabase Free Tier)
# NOTA CRÍTICA FREE TIER:
# DATABASE_URL: Debe apuntar al Connection Pooler (puerto 6543) con ?pgbouncer=true para no saturar las 15 conexiones directas.
# DIRECT_URL: Apunta al puerto 5432 directo para migraciones DDL de Prisma.
DATABASE_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase BaaS (Auth y Storage)
SUPABASE_URL="https://[TU-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[TU-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[TU-SUPABASE-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET_SIGNATURES="signatures"
SUPABASE_STORAGE_BUCKET_REPORTS="technical-reports"

# Seguridad y Autenticación JWT
JWT_SECRET="fildlab-secret-key-super-secure-change-in-production-2026"
JWT_EXPIRES_IN="8h"

# Módulo de Machine Learning (Inferencia Local ONNX en Node.js <= 40MB RAM)
ML_MODEL_PATH="./ml-models/rul_pipeline.onnx"
ML_FAILURE_RISK_THRESHOLD=0.80

# Keep-Alive Config (Mitigación Cold Starts en Free Tier)
ENABLE_KEEP_ALIVE=true
