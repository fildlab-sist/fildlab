// ------------------------------------------------------------------------------
// GOBERNANZA DE USUARIOS Y ROLES (RN-01)
// ------------------------------------------------------------------------------

enum UserRole {
  GERENCIA
  TECNICO
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         UserRole  @default(TECNICO)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relaciones
  assignedOrders       WorkOrder[]          @relation("TechnicianOrders")
  liquidatedOrders     WorkOrder[]          @relation("LiquidatedByGerencia")
  createdContracts     Contract[]           @relation("ContractsCreatedBy")
  technicianStock      TechnicianStock[]
  stockMovements       StockMovement[]      @relation("UserStockMovements")
  createdAddendums     WorkOrderAddendum[]  @relation("AddendumsCreatedBy")

  @@map("users")
}
